<main class="auth">
  <div class="auth__card">
    <div class="auth__badge">PASSWORD RESET</div>
    <h1 class="auth__title">kamome</h1>
    <p class="auth__sub">Choose a new password</p>

    <% if flash[:alert] %>
      <div class="auth__flash auth__flash--alert"><%= flash[:alert] %></div>
    <% end %>

    <%= form_with url: password_path(params[:token]), method: :put, class: "auth__form" do |form| %>
      <%= form.label :password, "New password (12+ chars)", class: "auth__label" %>
      <%= form.password_field :password, required: true, autofocus: true,
            minlength: 12, maxlength: 72, autocomplete: "new-password",
            class: "auth__input" %>

      <%= form.label :password_confirmation, "Confirm new password", class: "auth__label" %>
      <%= form.password_field :password_confirmation, required: true,
            minlength: 12, maxlength: 72, autocomplete: "new-password",
            class: "auth__input" %>

      <%= form.submit "Save new password", class: "auth__button" %>
    <% end %>
  </div>
</main>