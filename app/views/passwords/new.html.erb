<main class="auth">
  <div class="auth__card">
    <div class="auth__badge">PASSWORD RESET</div>
    <h1 class="auth__title">kamome</h1>
    <p class="auth__sub">Enter your email to receive reset instructions</p>

    <% if flash[:alert] %>
      <div class="auth__flash auth__flash--alert"><%= flash[:alert] %></div>
    <% end %>
    <% if flash[:notice] %>
      <div class="auth__flash auth__flash--notice"><%= flash[:notice] %></div>
    <% end %>

    <%= form_with url: passwords_path, class: "auth__form" do |form| %>
      <%= form.label :email_address, "Email", class: "auth__label" %>
      <%= form.email_field :email_address, required: true, autofocus: true,
            autocomplete: "username", placeholder: "you@example.com",
            value: params[:email_address], class: "auth__input" %>

      <%= form.submit "Send reset instructions", class: "auth__button" %>
    <% end %>

    <%= link_to "Back to sign in", new_session_path, class: "auth__link" %>
  </div>
</main>