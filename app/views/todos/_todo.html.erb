<li id="<%= dom_id(todo) %>" class="todo <%= 'todo--done' if todo.done %>">
  <%= button_to todo_path(todo), method: :patch,
        params: { todo: { done: !todo.done } },
        class: "todo__check", form_class: "todo__form",
        "aria-label": "Toggle done" do %>
    <%= todo.done ? "✓" : "" %>
  <% end %>

  <span class="todo__title"><%= todo.title %></span>

  <div class="todo__actions">
    <%= link_to "Edit", edit_todo_path(todo), class: "btn btn--ghost btn--sm" %>
    <%= button_to "Delete", todo_path(todo), method: :delete,
          class: "btn btn--danger btn--sm", form_class: "todo__form",
          form: { data: { turbo_confirm: "Delete this task?" } } %>
  </div>
</li>