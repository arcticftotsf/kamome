<div class="app">
  <%= render "shared/header" %>

  <main class="app__main">
    <% if notice %>
      <div class="flash flash--notice"><%= notice %></div>
    <% end %>

    <section class="panel">
      <h2 class="panel__title">New task</h2>
      <%= render "form", todo: Todo.new %>
    </section>

    <section class="panel">
      <h2 class="panel__title">
        Tasks
        <span class="count"><%= @todos.count { |t| !t.done } %> open</span>
      </h2>

      <% if @todos.any? %>
        <ul class="todos">
          <%= render @todos %>
        </ul>
      <% else %>
        <p class="empty">No tasks yet.</p>
      <% end %>
    </section>
  </main>
</div>