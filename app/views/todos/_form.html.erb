<%= form_with(model: todo, class: "todo-form") do |form| %>
  <% if todo.errors.any? %>
    <div class="flash flash--alert">
      <% todo.errors.full_messages.each do |message| %>
        <div><%= message %></div>
      <% end %>
    </div>
  <% end %>

  <%= form.text_field :title, required: true, maxlength: 200,
        placeholder: "What needs to be done?", class: "input" %>

  <% if todo.persisted? %>
    <label class="check">
      <%= form.check_box :done %> Done
    </label>
  <% end %>

  <%= form.submit class: "btn btn--primary" %>
<% end %>